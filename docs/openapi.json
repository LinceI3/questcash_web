        "summary": "Elimina la cuenta. Irreversible; exige la contraseña.",
        "tags": [
          "Cuenta"
        ],
        "responses": {
          "200": {
            "description": "Correcto"
          },
          "400": {
            "description": "Datos inválidos; el cuerpo trae `errors`"
          },
          "401": {
            "description": "`token_expired` (renovable), `token_revoked` o `invalid_token`"
          },
          "403": {
            "description": "No es tuyo"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
