# .env.example — plantilla de variables de entorno de QuestCash.
# Copiar a `.env` y rellenar. `.env` está en .gitignore y NUNCA se versiona.
#
# Generar cada clave de 32 bytes con:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# --- Flask -----------------------------------------------------------------
SECRET_KEY=
JWT_SECRET_KEY=
JWT_EXP_DAYS=30

# --- Base de datos ---------------------------------------------------------
# En local con SQLite se puede dejar vacío (usa questcash.db).
DATABASE_URL=postgresql://questcash:CAMBIAME@db:5432/questcash
POSTGRES_PASSWORD=CAMBIAME

# --- Cifrado en reposo (Entregable ED, semana 1) ---------------------------
# DATA_ENC_KEY    : clave AES-256-GCM de los campos personales.
# BLIND_INDEX_KEY : clave HMAC-SHA256 del índice ciego del correo.
#
# ATENCIÓN: si se pierde DATA_ENC_KEY, los datos cifrados son irrecuperables.
# Si se cambia BLIND_INDEX_KEY hay que recalcular usuarios.correo_bi o nadie
# podrá iniciar sesión.
DATA_ENC_KEY=
BLIND_INDEX_KEY=

# --- Política de hashing de contraseñas ------------------------------------
# Formato de Werkzeug: scrypt:N:r:p — por omisión scrypt:32768:8:3 (OWASP).
PASSWORD_HASH_METHOD=scrypt:32768:8:3
